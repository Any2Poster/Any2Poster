# -- OpenRouter (primary API gateway) ------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -- LLM settings (used for Parse, Chunk, Analyze stages) ----------------------
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-5

# -- Any2Poster-specific model overrides ---------------------------------------
ANY2POSTER_LLM_MODEL=anthropic/claude-sonnet-4-5
ANY2POSTER_VISION_MODEL=anthropic/claude-sonnet-4-5

# -- Image generation (NanoBanana Pro / Gemini 3 Pro via OpenRouter) -----------
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=google/gemini-3-pro-image-preview

# -- Poster defaults -----------------------------------------------------------
DEFAULT_STYLE=light
DEFAULT_POSTER_WIDTH=48.0
DEFAULT_POSTER_HEIGHT=36.0
OUTPUT_DPI=150

# -- API base URLs (change only if using a proxy) -----------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -- Reliability settings ------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_RETRIES=3

# -- Debug ---------------------------------------------------------------------
DEBUG=false
